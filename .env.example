# Example environment variables for local development
PORT=8080
POSTGRES_USER=golanger
POSTGRES_PASSWORD=golanger
POSTGRES_DB=golanger
DATABASE_URL=host=db user=golanger password=golanger dbname=golanger port=5432 sslmode=disable
# Redis settings (docker service name is `redis`)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# JWT / admin secret
JWT_SECRET=change-me-secret
ADMIN_SECRET=change-me-admin-secret
