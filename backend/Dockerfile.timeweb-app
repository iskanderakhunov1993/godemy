FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go build -p=1 -o /app/server main.go

# App Platform does not allow mounting docker.sock, so the code runner falls
# back to local execution and needs the Go toolchain in the runtime image.
FROM golang:1.26-alpine

WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY --from=builder /app/server /app/server

EXPOSE 8080

CMD ["/app/server"]
