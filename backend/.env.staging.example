PORT=8080
JWT_SECRET=replace-with-long-random-secret-for-staging
DATABASE_URL=host=db user=golanger password=replace-staging-db-password dbname=golanger_staging port=5432 sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:13000,https://staging.example.com

# SMTP для писем восстановления пароля
SMTP_HOST=smtp.your-provider.com
